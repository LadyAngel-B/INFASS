@model INFASS.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<section class="page-section"
         style="padding-top: 7rem; padding-bottom: 5rem;">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="card shadow">

                    <div class="card-header bg-warning">

                        <h2 class="mb-0">
                            Update User
                        </h2>

                    </div>


                    <div class="card-body p-5">

                        <form asp-action="Edit"
                              asp-controller="Home"
                              method="post">


                            <!-- ID -->

                            <input type="hidden"
                                   asp-for="Id" />


                            <!-- NAME -->

                            <div class="form-floating mb-3">

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Name"
                                       required />

                                <label asp-for="FullName">
                                    Full Name
                                </label>

                            </div>


                            <!-- EMAIL -->

                            <div class="form-floating mb-3">

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="Email"
                                       required />

                                <label asp-for="Email">
                                    Email
                                </label>

                            </div>


                            <!-- PASSWORD -->

                            <div class="form-floating mb-4">

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Password"
                                       required />

                                <label asp-for="Password">
                                    Password
                                </label>

                            </div>


                            <div class="d-flex gap-2">

                                <button type="submit"
                                        class="btn btn-success">

                                    Save Changes

                                </button>


                                <a asp-controller="Home"
                                   asp-action="Users"
                                   class="btn btn-secondary">

                                    Cancel

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>